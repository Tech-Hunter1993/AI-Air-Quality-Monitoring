# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables and secrets
.env
.env.*
*.pem
*.key

# Build and packaging
build/
dist/
*.egg-info/

# Test and coverage output
.pytest_cache/
.coverage
htmlcov/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Large or generated project artifacts
data/raw/*
data/processed/*
results/*
ai_model/*.pkl
ai_model/*.joblib
ai_model/*.h5
ai_model/*.pt
ai_model/*.onnx

# Keep placeholder files
!data/raw/.gitkeep
!data/raw/README.md
!data/processed/.gitkeep
!data/processed/README.md
!data/sample/
!data/sample/README.md
!data/sample/synthetic_air_quality_sample.csv
